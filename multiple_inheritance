# #multiple inheritance
class camera:
    def take_photo(self):
        print("taking a photo")
class musicplayer:
    def play_music(self):
        print("playing music")
class smartphone(camera,musicplayer):
    def call(self):
        print("making a phone call")
mi=smartphone
mi.call()
mi.power_on()
mi.take_photo()
mi.playing()